# Copy to .env.local for local development. Never commit your real .env.local.
# Same Supabase project / same variables as the Flask app, so existing data keeps working.
SUPABASE_URL=https://zopkjvirelwgwtzvrxwl.supabase.co
# Use the SECRET / service_role key (server only). The anon/publishable key will NOT work (RLS blocks it).
SUPABASE_KEY=
# Long random string used to sign session cookies (e.g. `openssl rand -base64 48`).
SECRET_KEY=

# Optional email features (Gmail address + app password)
SENDER_EMAIL=
SENDER_PASSWORD=
